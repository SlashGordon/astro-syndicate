{
  "name": "astro-syndicate",
  "type": "module",
  "version": "0.7.0",
  "license": "MIT",
  "author": "SlashGordon",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "ci",
    "build",
    "syndicate",
    "dev.to"
  ],
  "homepage": "https://www.slashgordon.link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SlashGordon/astro-syndicate.git"
  },
  "bugs": {
    "url": "https://github.com/SlashGordon/astro-syndicate/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "syndicate": "tsx scripts/syndicate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "demo:dev": "npm run dev --prefix demo",
    "demo:build": "npm run build --prefix demo",
    "demo:preview": "npm run preview --prefix demo",
    "demo:reset": "tsx scripts/reset-content.ts demo/src/content/blog",
    "reset-content": "tsx scripts/reset-content.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "astro": "^5.6.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "astro": "^5.6.0",
    "tsx": "^4.23.13",
    "vitest": "^3.2.7"
  }
}
